# Porta do servidor
PORT=3000

# Ambiente: em "production" os cookies exigem HTTPS e o HSTS é ativado
NODE_ENV=development

# Primeiro administrador (criado automaticamente se não houver usuários).
# Defina uma senha forte ANTES do primeiro start.
ADMIN_EMAIL=voce@seudominio.com
ADMIN_SENHA=troque-por-uma-senha-forte

# ===== Resumo automático de reunião (feature 002) =====
# Chave do provedor de IA. Sem ela o servidor sobe normalmente e a feature
# aparece indisponível — nenhuma outra tela é afetada.
ANTHROPIC_API_KEY=
# Modelo usado na extração. Trocar aqui não exige alterar código.
IA_MODELO=claude-opus-5
# Teto de tokens de entrada por extração (guarda de custo, ~US$ 0,10-0,13 por reunião).
IA_MAX_TOKENS_ENTRADA=60000
