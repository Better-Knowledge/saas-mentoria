# Porta do servidor
PORT=3000

# Ambiente: em "production" os cookies exigem HTTPS e o HSTS é ativado
NODE_ENV=development

# Primeiro administrador (criado automaticamente se não houver usuários).
# Defina uma senha forte ANTES do primeiro start.
ADMIN_EMAIL=voce@seudominio.com
ADMIN_SENHA=troque-por-uma-senha-forte
