# Porta do servidor
PORT=3000

# Ambiente: em "production" os cookies exigem HTTPS e o HSTS é ativado
NODE_ENV=development

# URL pública do app (links de checkout, callbacks, webhooks)
APP_URL=http://localhost:3000

# Primeiro administrador / operador da plataforma (criado se não houver usuários).
ADMIN_EMAIL=voce@seudominio.com
ADMIN_SENHA=troque-por-uma-senha-forte

# ===== Banco (PostgreSQL + RLS) =====
# A aplicação conecta com um papel SEM BYPASSRLS (isolamento multi-tenant no banco).
DATABASE_URL=postgres://app_role:troque@localhost:5432/saas

# Chave de criptografia (32 bytes em hex) p/ cifrar credenciais por org (ex.: Evolution da org VIP)
ENCRYPTION_KEY=

# ===== Cobrança (pagar.me) =====
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=
TRIAL_DIAS=14
GRACE_DIAS=5
RETENCAO_DIAS=90

# ===== IA (Anthropic Claude) =====
ANTHROPIC_API_KEY=
# IDs de modelo por tarefa (trocáveis sem mexer na lógica)
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-8

# ===== WhatsApp (provider não oficial — VIP) =====
# Provider ativo: evolution | zapi  (inicialmente evolution)
WHATSAPP_PROVIDER=evolution
EVOLUTION_URL=
EVOLUTION_API_KEY=
ZAPI_URL=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
